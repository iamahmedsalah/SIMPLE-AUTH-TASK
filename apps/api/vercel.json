{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,

  "installCommand": "pnpm install --frozen-lockfile --prod=false",
  "buildCommand": "pnpm --filter @fst/validation build && pnpm --filter @fst/api build && pnpm --filter @fst/api bundle:workspace",

  "functions": {
    "api/index.ts": {
      "maxDuration": 30,
      "includeFiles": "node_modules/@fst/validation/**"
    }
  },

  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}