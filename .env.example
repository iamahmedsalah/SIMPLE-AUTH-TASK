NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/fst-auth
DNS_SERVERS=8.8.8.8,1.1.1.1
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=15m
FRONTEND_URL=http://localhost:5173
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=FST Auth <no-reply@example.com>
SWAGGER_ENABLED=true
LOG_LEVEL=debug
COOKIE_NAME=fst_auth
